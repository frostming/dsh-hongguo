{
  "name": "dsh-hongguo",
  "version": "1.2.1",
  "private": true,
  "type": "module",
  "description": "摸鱼短剧：右侧边栏短剧播放器，等待 Agent 时提示调出（基于 openhongguo）",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./vendor/*": "./vendor/*",
    "./standalone/*": "./standalone/*",
    "./sdk/*": "./sdk/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "vendor/",
    "standalone/",
    "sdk/",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "openhongguo": "0.1.0"
  }
}
